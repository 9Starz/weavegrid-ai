# Optional — enables the Claude-powered Copilot. Server-side only; never exposed
# to the browser (no NEXT_PUBLIC_ prefix). Without it, the copilot runs on the
# deterministic rule engine and everything else works unchanged.
# Get a key at https://console.anthropic.com/ then copy this file to .env.local
ANTHROPIC_API_KEY=

# --- Public-demo protection (Copilot Claude pathway only) --------------------
# Durable per-IP rate limiting + global daily ceiling for the paid Claude path.
# Server-side only. Uses the official Upstash integration variable names, so the
# Vercel/Upstash integration populates these automatically when connected.
#
# LOCAL DEV: leave these BLANK. The Copilot still runs and enforces the same
#   limits using an in-process (in-memory) backend, so no Redis is needed to
#   develop or test locally.
# PRODUCTION (Vercel): set both. If they are MISSING in production, the Copilot
#   fails safe — it skips Claude and answers from the rule engine rather than
#   allowing unlimited, unmetered Claude calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global ceiling on Claude calls per day across ALL visitors. Optional.
# Defaults to 200 when unset. Change here (or in Vercel env) to adjust budget.
ANTHROPIC_DAILY_CALL_LIMIT=
